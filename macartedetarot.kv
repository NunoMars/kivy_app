#:import AutoScrollLabel __main__.AutoScrollLabel

<RootScreen>:
    # Pas besoin de déclarer les écrans ici, ils sont ajoutés en Python

<CardScreen>:
    name: "card_screen"
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: "tarot_img/bg.jpg"

        # Titre en haut
        Label:
            id: app_title_label
            text: "Loading..."
            font_size: "20sp"
            halign: 'center'
            valign: 'middle'
            bold: True
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 4
            size_hint_y: 0.15
            text_size: self.size

        # Zone carte (70% de l'écran)
        FloatLayout:
            size_hint_y: 0.7
            Button:
                id: draw_button
                background_color: 0, 0, 0, 0
                on_press: root.draw_card()
                size_hint: 0.8, 0.9
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                Image:
                    id: card_image
                    source: "tarot_img/Back.jpg"
                    size: self.parent.size
                    pos: self.parent.pos
                    fit_mode: "contain"
                    allow_stretch: True
                    keep_ratio: True
        
        # Instructions en bas
        Label:
            id: instruction_label
            text: "Loading..."
            font_size: "18sp"
            multiline: True
            halign: 'center'
            valign: 'middle'
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 4
            size_hint_y: 0.15
            text_size: self.size

<CardResponseScreen>:
    name: "response_screen"
    card_name: card_name
    card_state: card_state
    card_image: card_image
    card_text: card_text
    states_label: states_label
    BoxLayout:
        orientation: "vertical"
        spacing: 10
        padding: [10, 10, 10, 10]
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: "tarot_img/bg.jpg"
        
        # Image de la carte - Plus grande pour mobile
        Image:
            id: card_image
            size_hint: 1, None
            height: min(dp(300), self.parent.height * 0.4)  # Plus haute
            pos_hint: {'center_x': 0.5}
            allow_stretch: True
            keep_ratio: True
            
        # Nom de la carte
        Label:
            id: card_name
            bold: True
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 2
            size_hint: 1, None
            height: dp(40)
            font_size: "22sp"
            multiline: True
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            
        # État de la carte (droite/inversée)
        Label:
            id: card_state
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 2
            font_size: "16sp"
            multiline: True
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'
            size_hint: 1, None
            height: dp(35)
            bold: True
            
        # Mots-clés de la carte
        Label:
            id: states_label
            color: 1, 1, 1, 1
            font_size: "14sp"
            multiline: True
            text_size: self.width - dp(40), None
            halign: 'center'
            valign: 'middle'
            canvas.before:
                Color:
                    rgba: 0.6, 0.4, 0.2, 0.8
                RoundedRectangle:
                    pos: self.x + dp(20), self.y + dp(5)
                    size: self.width - dp(40), max(self.texture_size[1] + dp(20), dp(40))
                    radius: [10, 10, 10, 10]
            padding: [20, 10, 20, 10]
            size_hint: 1, None
            height: max(self.texture_size[1] + dp(20), dp(50))
            
        # Signification de la carte - avec scroll
        ScrollView:
            id: card_scroll
            size_hint: 1, 1
            do_scroll_x: False
            do_scroll_y: True
            
            AutoScrollLabel:
                id: card_text
                font_size: "16sp"
                multiline: True
                text_size: self.width - dp(40), None
                size_hint_y: None
                height: max(self.texture_size[1] + dp(40), dp(100))
                halign: 'center'
                valign: 'top'
                color: 0.6, 0.4, 0.2, 1.0
                outline_color: 1, 1, 1, 1
                outline_width: 1
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.85
                    RoundedRectangle:
                        pos: self.x + dp(20), self.y + dp(10)
                        size: self.width - dp(40), self.height - dp(20)
                        radius: [15, 15, 15, 15]
                padding: [30, 20, 30, 20]

        # Bouton "Nouveau tirage" - sera mis à jour par Python
        Button:
            id: back_button
            text: "Loading..."  # Texte temporaire
            size_hint: 0.7, None
            height: dp(50)
            pos_hint: {'center_x': 0.5}
            on_press: root.on_button_press()
            canvas.before:
                Color:
                    rgba: 0.6, 0.4, 0.2, 1.0
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [25, 25, 25, 25]
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: "18sp"
            bold: True
