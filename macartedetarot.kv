<RootScreen>:
    CardScreen:  
    CardResponseScreen:

<CardScreen>:
    name: "hello_screen"
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: "tarot_img/bg.jpg"

        Label:
            text: "Bienvenue \ndans le tarot divinatoire"
            font_size: "32sp"
            multiline: True
            halign: 'center'
            valign: 'middle'
            bold: True
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 4

        Button:
            id: draw_button
            background_color: 0, 0, 0, 0
            size_hint: 0.6, 0.4  # Taille raisonnable pour la carte
            pos_hint: {'center_x': 0.5, 'center_y': 0.6}  # Centré horizontalement et un peu vers le haut
            on_press: root.manager.current = "response_screen"
            
            Image:
                id: card_image
                source: "tarot_img/Back.jpg"
                center: self.parent.center
                size: self.parent.size
        Label:
            text: "Cliquez sur la carte\npour une prédiction"
            font_size: "24sp"
            multiline: True
            size_hint: 1, 0.2
            pos_hint: {'center_x': 0.5, 'center_y': 0.25}  # Positionné en bas
            halign: 'center'
            valign: 'middle'
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 4


<CardResponseScreen>:
    name: "response_screen"
    card_name: card_name
    card_state: card_state
    card_image: card_image
    card_text: card_text
    states_label: states_label
    BoxLayout:
        orientation: "vertical"
        spacing: 5
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: "tarot_img/bg.jpg"
                
        # Nom de la carte
        Label:
            id: card_name
            bold: True
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 2
            size_hint: 1, 0.2
            font_size: "28sp"
            halign: 'center'
            valign: 'middle'
            
        # État de la carte (endroit/envers)
        Label:
            id: card_state
            bold: True
            color: 0.8, 0.2, 0.2, 1.0  # Rouge pour l'état
            outline_color: 1, 1, 1, 1
            outline_width: 1
            size_hint: 1, 0.15
            font_size: "20sp"
            halign: 'center'
            valign: 'middle'
            halign: 'center'
            valign: 'middle'

        BoxLayout:
            orientation: "horizontal"
            spacing: 1 
            
            Image:
                id: card_image
                size_hint: 1, 1
                pos_hint: {'center_x':0.1,'center_y':0.5}  
            
            BoxLayout:
                orientation: "vertical"
                size_hint: 0.6, 0.8  # Limiter à 80% de la hauteur disponible
                spacing: 5
                padding: [10, 10]
                
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [15, 15]
                    spacing: 10
                    
                    canvas.before:
                        Color:
                            rgba: 0.6, 0.4, 0.2, 0.8  # Fond marron mystique
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                    
                    Label:
                        id: states_label
                        font_size: "12sp"  # Police encore plus petite
                        multiline: True
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: 'center'
                        valign: 'middle'
                        color: 1, 1, 1, 1.0  # Texte blanc sur fond marron
                        bold: True
                        line_height: 1.1  # Ligne plus compacte
        BoxLayout:
            orientation: "horizontal"
            spacing: 5
            padding: [10, 10]
            
            ScrollView:
                id: text_scroll
                bar_width: 8
                bar_color: 0.6, 0.4, 0.2, 0.8
                bar_inactive_color: 0.6, 0.4, 0.2, 0.4
                
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [15, 15]
                    spacing: 10
                    
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 0.9  # Fond blanc semi-transparent
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                    
                    Label:
                        id: card_text
                        font_size: "14sp"  # Police légèrement diminuée aussi
                        multiline: True
                        text_size: self.width - 30, None  # Moins 30 pour le padding
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: 'left'
                        valign: 'top'
                        color: 0.2, 0.2, 0.2, 1.0  # Texte sombre sur fond clair
                        line_height: 1.1  # Espacement entre les lignes plus compact

        Button:
            id: back_button
            text: "Nouveau tirage"
            size_hint: 0.6, 0.15
            pos_hint: {'center_x': 0.5, 'center_y': 0.1}
            font_size: "22sp"
            bold: True
            background_color: 0.6, 0.4, 0.2, 0.8  # Même marron mystique que states_label
            color: 1, 1, 1, 1  # Texte blanc
            on_press: root.on_button_press()  # Utiliser la méthode avec animation 
