#:import AutoScrollLabel __main__.AutoScrollLabel

<RootScreen>:
    CardScreen:  
    CardResponseScreen:

<CardScreen>:
    name: "hello_screen"
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: "tarot_img/bg.jpg"

        Label:
            text: "Bienvenue \ndans le tarot divinatoire"
            font_size: "28sp"
            multiline: True
            halign: 'center'
            valign: 'middle'
            bold: True
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 4

        Button:
            id: draw_button
            background_color: 0, 0, 0, 0
            on_press: root.draw_card()
            halign: 'center'
            valign: 'middle'
            Image:
                id: card_image
                source: "tarot_img/Back.jpg"
                center: self.parent.center
                size: self.parent.size
        Label:
            text: "Cliquez sur la carte\npour une prédiction"
            font_size: "28sp"
            multiline: True
            halign: 'center'
            valign: 'middle'
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 4


<CardResponseScreen>:
    name: "response_screen"
    card_name: card_name
    card_state: card_state
    card_image: card_image
    card_text: card_text
    states_label: states_label
    BoxLayout:
        orientation: "vertical"
        spacing: 10
        padding: [10, 10, 10, 10]
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: "tarot_img/bg.jpg"
        
        # Image de la carte - en haut
        Image:
            id: card_image
            size_hint: 1, None
            height: min(dp(250), self.parent.height * 0.35)
            pos_hint: {'center_x': 0.5}
            
        # Nom de la carte
        Label:
            id: card_name
            bold: True
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 2
            size_hint: 1, None
            height: dp(40)
            font_size: "22sp"
            multiline: True
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            
        # État de la carte (droite/inversée)
        Label:
            id: card_state
            color: 0.6, 0.4, 0.2, 1.0
            outline_color: 1, 1, 1, 1
            outline_width: 2
            font_size: "16sp"
            multiline: True
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'
            size_hint: 1, None
            height: dp(35)
            bold: True
            
        # Mots-clés de la carte
        Label:
            id: states_label
            color: 1, 1, 1, 1
            font_size: "14sp"
            multiline: True
            text_size: self.width - dp(40), None
            halign: 'center'
            valign: 'middle'
            canvas.before:
                Color:
                    rgba: 0.6, 0.4, 0.2, 0.8
                RoundedRectangle:
                    pos: self.x + dp(20), self.y + dp(5)
                    size: self.width - dp(40), max(self.texture_size[1] + dp(20), dp(40))
                    radius: [10, 10, 10, 10]
            padding: [20, 10, 20, 10]
            size_hint: 1, None
            height: max(self.texture_size[1] + dp(20), dp(50))
            
        # Signification de la carte - avec scroll
        ScrollView:
            id: card_scroll
            size_hint: 1, 1
            do_scroll_x: False
            do_scroll_y: True
            
            AutoScrollLabel:
                id: card_text
                font_size: "16sp"
                multiline: True
                text_size: self.width - dp(40), None
                size_hint_y: None
                height: max(self.texture_size[1] + dp(40), dp(100))
                halign: 'center'
                valign: 'top'
                color: 0.6, 0.4, 0.2, 1.0
                outline_color: 1, 1, 1, 1
                outline_width: 1
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.85
                    RoundedRectangle:
                        pos: self.x + dp(20), self.y + dp(10)
                        size: self.width - dp(40), self.height - dp(20)
                        radius: [15, 15, 15, 15]
                padding: [30, 20, 30, 20]

        # Bouton "Nouveau tirage" - en bas
        Button:
            id: back_button
            text: "Nouveau tirage"
            size_hint: 0.7, None
            height: dp(50)
            pos_hint: {'center_x': 0.5}
            on_press: root.on_button_press()
            canvas.before:
                Color:
                    rgba: 0.6, 0.4, 0.2, 1.0
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [25, 25, 25, 25]
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: "18sp"
            bold: True 
